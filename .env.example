# --- Database ---
POSTGRES_USER=rowing
POSTGRES_PASSWORD=change_me
POSTGRES_DB=rowing_analytics
POSTGRES_PORT=5432

# Used by the backend container (host name matches the docker-compose service name "db")
DATABASE_URL=postgresql+psycopg://rowing:change_me@db:5432/rowing_analytics

# --- Auth ---
SECRET_KEY=replace_with_a_long_random_secret_value
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
